import java.util.Scanner;

public class Whileloop1 {
    public static void main(String[] args) {
        int num, sum = 0;
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter a four digit number: ");
        num = sc.nextInt();

        while (num != 0) {
            sum += num % 10;
            num /= 10;
        }

        System.out.println("Sum of digits: " + sum);
        sc.close();
    }
}
