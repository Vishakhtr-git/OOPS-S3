import javax.swing.*;
import java.awt.event.*;
import java.awt.*;

public class Main extends JFrame implements ActionListener
{
    JTextField t1, t2, t3, t4, t5, t6, t7;
    JButton cr, re;

    Main()
    {
        JFrame f = new JFrame("TripMate - Create Trip");
        JPanel p = new JPanel();
        p.setLayout(new GridLayout(8, 2));

        JLabel l1 = new JLabel("Destination");
        t1 = new JTextField();
        JLabel l2 = new JLabel("Duration (days)");
        t2 = new JTextField();
        JLabel l3 = new JLabel("No. of Travellers");
        t3 = new JTextField();
        JLabel l4 = new JLabel("Budget");
        t4 = new JTextField();
        JLabel l5 = new JLabel("Preference");
        t5 = new JTextField();
        JLabel l6 = new JLabel("Traveller Names");
        t6 = new JTextField();

        cr = new JButton("Create Trip");
        re = new JButton("Reset");

        JLabel l7 = new JLabel("Trip Summary");
        t7 = new JTextField();

        p.add(l1); p.add(t1);
        p.add(l2); p.add(t2);
        p.add(l3); p.add(t3);
        p.add(l4); p.add(t4);
        p.add(l5); p.add(t5);
        p.add(l6); p.add(t6);
        p.add(cr); p.add(re);
        p.add(l7); p.add(t7);

        cr.addActionListener(this);
        re.addActionListener(this);

        f.add(p);
        f.setSize(450, 500);
        f.setVisible(true);
    }

    public void actionPerformed(ActionEvent e)
    {
        if (e.getSource() == cr)
        {
            String s1 = t1.getText();
            String s2 = t2.getText();
            String s3 = t3.getText();
            String s4 = t4.getText();
            String s5 = t5.getText();
            String s6 = t6.getText();

            if (s1.isEmpty() || s2.isEmpty() || s3.isEmpty() || s4.isEmpty() || s5.isEmpty() || s6.isEmpty())
            {
                t7.setText("Please fill all fields");
            }
            else
            {
                int days = Integer.parseInt(s2);
                int n = Integer.parseInt(s3);
                int budget = Integer.parseInt(s4);
                int c = budget / n;

                String rs = s1 + " | " + days + " days | " + n + " people | " + s5 + " | Per person: " + String.valueOf(c);
                t7.setText(rs);
            }
        }
        else if (e.getSource() == re)
        {
            t1.setText("");
            t2.setText("");
            t3.setText("");
            t4.setText("");
            t5.setText("");
            t6.setText("");
            t7.setText("");
        }
    }

    public static void main(String args[])
    {
        new Main();
    }
}
